#!/bin/bash
clear
url=$1
echo "----------yt-dlp Script for Termux----------"
echo "----------Last updated Nov 22 2026----------"
echo "--------------------------------------------"
echo "1: Video Download"
echo "2: Musik Download"
echo "Default: Download with yt-dlp (Fixed Bandwidth Throttling by YouTube)"
read n


if [ "$n" == '2' ]; then
[ ! -d "/data/data/com.termux/files/home/storage/shared/youtube-dl" ] && mkdir "/data/data/com.termux/files/home/storage/shared/youtube-dl"
yt-dlp -x --audio-format mp3 -f bestaudio --audio-quality 0 --add-metadata --embed-thumbnail -c -i "$url" -o "/data/data/com.termux/files/home/storage/shared/youtube-dl/%(title)s.%(ext)s"
else


[ ! -d "/data/data/com.termux/files/home/storage/shared/youtube-dl" ] && mkdir "/data/data/com.termux/files/home/storage/shared/youtube-dl"
yt-dlp -c -i "$url" -o "/data/data/com.termux/files/home/storage/shared/youtube-dl/%(title)s.%(ext)s"
fi



